{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{src,config}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index?path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 4 * * *"
    }
  ]
}