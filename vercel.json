{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "functions": {
    "api/index.js": {
      "includeFiles": "src/dashboard.html",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?path="
    },
    {
      "source": "/:path*",
      "destination": "/api/index?path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 4 * * *"
    }
  ]
}